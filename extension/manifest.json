{
  "manifest_version": 3,
  "name": "MTG Tracker (LigaMagic)",
  "version": "0.4.0",
  "description": "Salva todo dia o histórico de preço dos seus decks da LigaMagic.",
  "permissions": ["storage", "activeTab", "cookies", "alarms"],
  "host_permissions": [
    "https://mtg.jrfsoftware.com.br/*",
    "https://*.onrender.com/*",
    "http://localhost:8080/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.ligamagic.com.br/*", "https://ligamagic.com.br/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://mtg.jrfsoftware.com.br/*", "https://*.onrender.com/*", "http://localhost:8080/*"],
      "js": ["site.js"],
      "run_at": "document_start"
    }
  ],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_title": "MTG Tracker", "default_icon": { "16": "icons/16.png", "48": "icons/48.png" } }
}
